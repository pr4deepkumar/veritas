# VERITAS environment variables. Copy to .env and uncomment what you want to change.
# Everything runs on your machine by default: no API keys and no cloud services needed.

# --- Local stack (the default) -------------------------------------------------
# Which backends answer questions and store the index: local or claude, local or pinecone.
# LLM_PROVIDER=local
# VECTOR_STORE=local

# Hugging Face models (downloaded once on first use, about 3.7 GB in total).
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# LOCAL_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Where the answer and NLI models run: auto (CUDA, then Apple MPS, then CPU), cuda, mps or cpu.
# LOCAL_DEVICE=auto
# LOCAL_MAX_NEW_TOKENS=512

# Folder that python -m pipelines.ingest_local indexes (console uploads go to uploads/ inside it),
# and where the index file is kept.
# DOCUMENTS_DIR=data/documents
# LOCAL_INDEX_DIR=data/index

# Chunk size and overlap, in characters
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=200

# --- Optional: Claude (LLM_PROVIDER=claude) -------------------------------------
# A key also enables the "nli" and "llm-as-judge" verification modes.
# VERIFIER_MODEL defaults to CHAT_MODEL. Effort is one of: low, medium, high, xhigh, max.
# REFUSAL_FALLBACK re-runs a request the model declines on a fallback model;
# set it to false for models without server-side fallback support.
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-sonnet-5-5
# VERIFIER_MODEL=claude-sonnet-5-5
# ANSWER_EFFORT=medium
# VERIFIER_EFFORT=medium
# REFUSAL_FALLBACK=true

# --- Optional: Pinecone (VECTOR_STORE=pinecone) ---------------------------------
# PINECONE_API_KEY=
# PINECONE_INDEX=veritas-research
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- Optional: S3 ingestion pipelines (pipelines.ingest_from_s3 / index_to_pinecone) ---
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_INPUT_PREFIX=input_pdfs/
# S3_OUTPUT_PREFIX=parsed_json/

# LOG_LEVEL=INFO
