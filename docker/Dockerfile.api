FROM python:3.11-slim

# WEB_DIR: the package is installed into site-packages, so tell the API where the console lives.
# This is the cloud image (Claude + Pinecone); the local-model stack runs natively, not in here.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    WEB_DIR=/app/ui/web \
    LLM_PROVIDER=claude \
    VECTOR_STORE=pinecone

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install .

COPY ui ./ui

RUN useradd --create-home --uid 10001 veritas
USER veritas

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"]

CMD ["uvicorn", "veritas.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
